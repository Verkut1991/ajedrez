<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fondoJugar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="275dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btnRendirse"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorSurface"
                android:textColor="?attr/colorOnPrimary"
                android:text="Rendirse" />

            <TextView
                android:id="@+id/txtTurno"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:gravity="center"
                android:text="Turno de blanco"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold" /> <!-- Esto centra el texto -->
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="63dp"
                    android:background="?attr/colorSurface"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtNombreJugador"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="26dp"
                        android:gravity="center"
                        android:textColor="?attr/colorOnPrimary"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSecondary"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="224dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtAlfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorPrimary"
                            android:text="" />
                        <TextView
                            android:id="@+id/txtPeon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorPrimary"
                            android:text="" />

                        <TextView
                            android:id="@+id/txtReina"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorPrimary"
                            android:text="" />
                        <TextView
                            android:id="@+id/txtCaballo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorPrimary"
                            android:text="" />
                        <TextView
                            android:id="@+id/txtTorre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorPrimary"
                            android:text="" />
                        <TextView
                            android:id="@+id/txtRey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorPrimary"
                            android:text="" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/colorSurface"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtTimer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="60dp"
                            android:gravity="center"
                            android:text="00:00" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/posFragmentosTablero"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    </FrameLayout>
</LinearLayout>